# Copy to .env.local and fill in. .env.local is gitignored. On Vercel, set these in Project Settings.

# Required for live chat and for running evals.
ANTHROPIC_API_KEY=
# Only needed if your key is NOT scoped to a workspace (Console > Settings > Workspaces, ID starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=

# Required in production: signs live-chat session tokens (32+ random characters).
# Generate one with: openssl rand -hex 32
SESSION_SECRET=

# Required in production for rate limiting (free Upstash Redis database).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Live chat spend controls (defaults shown).
LIVE_CHAT_ENABLED=true            # set to false to turn live chat off instantly
LIVE_CHAT_DAILY_CAP=60            # new conversations per day, all visitors combined
LIVE_CHAT_PER_IP_DAILY=5          # new conversations per visitor per day
LIVE_CHAT_PER_IP_MESSAGES_HOURLY=60
LIVE_CHAT_MAX_MESSAGES=16         # borrower messages per conversation
LIVE_CHAT_MAX_CHARS=500
